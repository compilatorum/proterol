{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProofCarryingConstruct",
  "description": "JSON Schema for a Proof-Carrying Construct: K^pi = <K, pi>",
  "type": "object",
  "required": ["construct", "proof"],
  "properties": {
    "construct": {
      "type": "object",
      "required": ["id", "name", "genes"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "genes": { "type": "array" },
        "capabilities": { "type": "array" },
        "transformations": { "type": "array" },
        "state": { "type": "object" }
      }
    },
    "proof": {
      "type": "object",
      "required": ["proposition", "prover", "evidence_digest", "is_valid"],
      "properties": {
        "proposition": { "type": "string" },
        "prover": { "type": "string" },
        "proof_type": { "type": "string" },
        "evidence_digest": { "type": "string" },
        "created_at": { "type": "string" },
        "is_valid": { "type": "boolean" },
        "details": { "type": "object" }
      }
    }
  }
}
